{
	"name": "teleagent",
	"version": "1.1.0",
	"description": "Bridge local entre agentes Cursor e Telegram — alertas e decisões humanas no loop, por projeto.",
	"type": "module",
	"bin": {
		"teleagent": "./dist/index.js"
	},
	"files": [
		"dist",
		"skills",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"serve": "tsx src/index.ts serve",
		"typecheck": "tsc --noEmit",
		"desktop:install": "npm install --prefix desktop",
		"desktop:dev": "npm run build && npm --prefix desktop start",
		"desktop:dist": "npm run build && npm --prefix desktop run dist",
		"website:dev": "npm --prefix website run dev",
		"website:build": "npm --prefix website run build"
	},
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"cursor",
		"telegram",
		"ai-agent",
		"human-in-the-loop",
		"local-first",
		"electron",
		"cli"
	],
	"author": "MatheusLTrindade",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MatheusLTrindade/Teleagent.git"
	},
	"bugs": {
		"url": "https://github.com/MatheusLTrindade/Teleagent/issues"
	},
	"homepage": "https://github.com/MatheusLTrindade/Teleagent#readme",
	"dependencies": {
		"grammy": "^1.36.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3"
	}
}
