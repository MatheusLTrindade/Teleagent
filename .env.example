# Token do bot (BotFather) — também pode ficar em ~/.teleagent/config.json
TELEAGENT_BOT_TOKEN=

# Seu chat_id (preenchido pelo `teleagent setup` ou /start no bot)
TELEAGENT_CHAT_ID=

# Allowlist de user ids do Telegram (separados por vírgula)
TELEAGENT_ALLOWED_USER_IDS=

# Porta do bridge local (default: 3847)
TELEAGENT_PORT=3847

# Nome padrão do projeto (opcional)
TELEAGENT_PROJECT=
